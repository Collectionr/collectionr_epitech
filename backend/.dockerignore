# Dependencies are installed inside the image
node_modules

# Build outputs — regenerated inside the image
dist
coverage

# Generated Prisma client — regenerated by `prisma generate` (postinstall) in the image
src/generated

# Secrets and local environment — never baked into the image (.env.example stays)
.env
.env.*
!.env.example

