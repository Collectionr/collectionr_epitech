// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Audit trail of sensitive actions (docs/database/schema-sql.md, docs/security/S05-logs-audit.md).
/// Append-only. `userId` FK added by COLLR-442 (ADR-011): ON DELETE SET NULL so a GDPR account
/// deletion never destroys the trace of past actions.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Convention `domain.verb`, suffixed `.failed` when the action failed (e.g. auth.login.failed).
  action     String
  targetType String?
  targetId   String?  @db.Uuid
  metadata   Json?
  timestamp  DateTime @default(now()) @db.Timestamptz(6)
  /// timestamp + AUDIT_LOG_RETENTION_DAYS, computed when the entry is written.
  expiresAt  DateTime @db.Timestamptz(6)

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([expiresAt])
  @@map("audit_logs")
}

/// Registered users (COLLR-415/COLLR-447). Mirrors src/modules/auth/domain/entities/User.ts;
/// `role` is a minimal, forward-compatible scaffold for RBAC (docs/security/S03-api-security.md
/// §5) — not the full ROLE/PERMISSION join tables from docs/database/schema-sql.md, which no
/// current use case reads or writes (see COLLR-415 summary).
model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String
  username        String
  /// The account's role, by foreign key (ADR-013): a role is named, never identified by a hard-coded UUID.
  roleId          String       @db.Uuid
  role            Role         @relation(fields: [roleId], references: [id])
  /// A deactivated account (admin action, CDC §3.5) cannot log in.
  isActive        Boolean      @default(true)
  /// Optimistic lock (User.version): incremented by every update, which must match the version the
  /// caller loaded, or a stale copy would overwrite a concurrent password change/deactivation.
  version         Int          @default(0)
  /// When the user accepted the terms of service (S04 §4: contract performance, not an optional consent).
  termsAcceptedAt DateTime     @db.Timestamptz(6)
  /// The version of the terms that was shown and accepted: the proof of what was agreed to.
  termsVersion    String
  /// Canonical username (User.usernameKey): unique, so "Pokemon" and "pokemon" cannot both exist.
  usernameKey     String       @unique
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  sessions        Session[]
  auditLogs       AuditLog[]
  collections     Collection[]

  @@index([roleId])
  @@map("users")
}

/// Refresh token sessions (docs/database/schema-sql.md SESSION, COLLR-633/COLLR-450).
/// `id` doubles as the JWT refresh token's `jti` claim, so a lookup never needs to scan hashes, and as
/// the `sid` claim of the access token issued with it (revoking the row kills that access token too).
/// `refreshTokenHash` (sha256) is defense in depth only — revocation is keyed by `id`.
/// One row per issued refresh token: a rotation retires the row (`rotatedAt`) and creates the next
/// one in the same `familyId`, so a token presented twice can be recognised as stolen and the whole
/// chain revoked.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Every token of one login chain shares it (set at login, inherited at each rotation).
  familyId          String    @db.Uuid
  refreshTokenHash  String
  /// Not populated yet: IAuthTokenService.issueTokenPair(userId) has no request context
  /// to read it from (application/ports/IAuthTokenService.ts is frozen, see COLLR-415 summary).
  ipAddress         String?
  isRevoked         Boolean   @default(false)
  /// Set when the token was exchanged for a new one. Distinguishes "rotated" (replaying it = theft)
  /// from "logged out / revoked" (replaying it is just a dead token).
  rotatedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  /// Hard end of the whole family, inherited unchanged: rotation can never extend a login past it.
  absoluteExpiresAt DateTime  @db.Timestamptz(6)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Retention period per entity type (GDPR Art. 5.1.e, docs/security/S04-rgpd-conformite.md §5).
/// Reference data: rows are written by the seeder (COLLR-543) and read by the deletion job (COLLR-544).
model DataRetentionPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  /// snake_case identifier of the data category (e.g. account, application_log, audit_log). One policy per type.
  entityType    String   @unique
  /// Counted from the entity's reference event (account closure for accounts, creation for logs).
  retentionDays Int
  description   String
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("data_retention_policies")
}

/// RBAC role (docs/database/schema-sql.md, docs/security/S03-api-security.md §5).
/// Reference data: rows are written by prisma/seed.ts (names in ROLE_NAMES, src/shared/config/AppConstants.ts).
/// Accounts reference this table through users.roleId (NOT NULL foreign key, ON DELETE RESTRICT).
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  /// Upper case identifier (USER, ADMIN). Unique so the seed can upsert on it.
  name        String           @unique
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

/// RBAC permission, named `resource:action` (e.g. collection:write, card:delete — docs/database/documentation-metier.md).
/// No permission is seeded yet: the list must be agreed with the team before COLLR-449.
model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

/// Join table between roles and permissions. Deleting a role or a permission deletes its associations.
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Licence of trading cards (docs/database/schema-sql.md: LICENCE_TCG, e.g. Pokémon). Reference data of the catalogue.
/// Part of the catalogue interface contract (ADR-015): the TCG microservice only UPSERTs into it,
/// on `slug`, and never creates or alters the table.
/// The catalogue tables generate their `id` in the database (not with Prisma's uuid(), which runs in the
/// client), so a raw SQL INSERT ... ON CONFLICT does not have to supply one.
model LicenceTCG {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier of the licence (e.g. pokemon). Conflict target of the UPSERT.
  slug        String       @unique
  name        String
  /// Logo of the licence. TCGdex has none: filled by hand or by the seed, as a URL (nothing is stored locally).
  logoUrl     String?
  sets        CardSet[]
  collections Collection[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("licences_tcg")
}

/// Set (expansion) of a game, from TCGdex `GET /v2/{lang}/sets/{id}` (en + fr merged in one row).
/// Named CardSet and not Set so the generated client does not shadow the JavaScript `Set`.
/// Catalogue interface contract (ADR-015): UPSERT on `tcgdexId`.
model CardSet {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  licenceTCGId          String     @db.Uuid
  /// TCGdex set id, identical in every language (e.g. base1, swsh3, sv03.5).
  tcgdexId              String     @unique
  nameEn                String
  /// null when TCGdex has no French translation of the set.
  nameFr                String?
  /// TCGdex series the set belongs to (e.g. swsh = Sword & Shield / Épée et Bouclier).
  serieTcgdexId         String?
  serieNameEn           String?
  serieNameFr           String?
  releaseDate           DateTime?  @db.Date
  /// Code printed on the cards of the set (e.g. DAA).
  abbreviationOfficial  String?
  /// French code, when it differs from the official one (e.g. TEM for DAA). Only the French response has it.
  abbreviationFr        String?
  /// Code of the set in Pokémon TCG Online / Live. null for the most recent sets.
  tcgOnlineCode         String?
  /// Cards printed in the set (TCGdex cardCount.official, e.g. 189 for swsh3).
  officialCardCount     Int
  /// Cards of the set including secret rares (TCGdex cardCount.total, e.g. 201 for swsh3).
  totalCardCount        Int
  /// Printings by variant (TCGdex cardCount.normal / reverse / holo / firstEd): one card can be counted in
  /// several of them, so they do not add up to the total.
  normalCardCount       Int?
  reverseCardCount      Int?
  holoCardCount         Int?
  firstEditionCardCount Int?
  /// TCGdex asset base URLs, without extension: nothing is stored locally. Logos depend on the language.
  logoUrlEn             String?
  logoUrlFr             String?
  symbolUrl             String?
  licenceTCG            LicenceTCG @relation(fields: [licenceTCGId], references: [id], onDelete: Restrict)
  cards                 Card[]
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt             DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([licenceTCGId])
  @@map("sets")
}

/// Card of a set, from TCGdex `GET /v2/{lang}/cards/{id}` (en + fr merged in one row).
/// Catalogue interface contract (ADR-015): UPSERT on `tcgdexId`. Prices are out of scope; the printings of a
/// card are in `variants`. Attacks, abilities, weaknesses, resistances and retreat cost are deliberately not stored.
model Card {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setId           String      @db.Uuid
  /// TCGdex card id, identical in every language (e.g. swsh3-20, sv03.5-006).
  tcgdexId        String      @unique
  /// TCGdex localId: the number inside the set, as printed. A string because of leading zeros (006) and prefixes (TG01).
  number          String
  nameEn          String
  /// null when TCGdex has no French translation of the card.
  nameFr          String?
  /// TCGdex category, in English: Pokemon, Trainer or Energy. Stored as a code, the front-end translates it.
  category        String
  /// Rarity as TCGdex words it in English (Common, Holo Rare VMAX…). A code too: the front-end translates it, and falls back on this text for a rarity it does not know yet.
  rarity          String?
  illustrator     String?
  /// Absent on most Trainer and Energy cards, present on a few (Fossils, Clefairy Doll).
  hp              Int?
  /// Energy types in English (Fire, Water…). Empty for most Trainer and Energy cards, but TCGdex does type some (e.g. a Psychic Energy).
  types           String[]    @default([])
  /// National Pokédex numbers of the Pokémon (e.g. [6] for Charizard): links every card of the same Pokémon,
  /// across sets and languages. Several numbers on cards that show several Pokémon.
  dexIds          Int[]       @default([])
  /// Name of the Pokémon this one evolves from (e.g. Charizard V for Charizard VMAX).
  evolveFromEn    String?
  evolveFromFr    String?
  /// Evolution stage, in English: Basic, Stage1, Stage2, VMAX… The front-end translates it.
  stage           String?
  /// Last modification of the card on the TCGdex side (TCGdex `updated`): lets the sync skip unchanged cards.
  tcgdexUpdatedAt DateTime?   @db.Timestamptz(6)
  /// TCGdex asset base URLs, without extension (append /high.webp for instance): nothing is stored locally.
  imageUrlEn      String?
  imageUrlFr      String?
  set             CardSet     @relation(fields: [setId], references: [id], onDelete: Restrict)
  variants        Variant[]
  cardEntries     CardEntry[]
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt       DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([setId])
  @@map("cards")
}

/// One printing of a card (normal, reverse holo, 1st edition stamped…), from TCGdex `variants_detailed`.
/// Catalogue interface contract (ADR-015): UPSERT on `(cardId, tcgdexVariantId)`. The TCGdex variantId is NOT
/// unique on its own: it identifies a kind of printing and is shared by many cards (the 16 first cards of base1
/// carry the same four). Collection items and prices will point at `id`.
/// Codes are stored in English only (lower case, kebab-case): TCGdex French labels are partly untranslated.
model Variant {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId              String      @db.Uuid
  tcgdexVariantId     String
  /// normal, reverse, holo, metal…
  type                String
  /// unlimited, shadowless, 1999-2000-copyright…
  subtype             String?
  /// standard or jumbo.
  size                String
  /// Stamps printed on the card (1st-edition, pikachu, snowflake…).
  stamps              String[]    @default([])
  /// Foil pattern (gold, rainbow, cosmos…).
  foil                String?
  /// Product ids of the printing at the price sources, to match prices later. null when the source has none.
  cardmarketProductId Int?
  tcgplayerProductId  Int?
  cardtraderProductId Int?
  card                Card        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardEntries         CardEntry[]
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt           DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([cardId, tcgdexVariantId])
  /// Target of the composite foreign key card_entries(cardId, variantId): proves a variant is a printing of THAT card (ADR-017).
  @@unique([cardId, id])
  @@map("variants")
}

/// Declared state of a physical card (CDC §3.1.4): near mint, lightly / moderately / heavily played, damaged.
enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

/// Language of the physical card (not of the text displayed).
enum CardLanguage {
  fr
  en
}

/// A named set of cards owned by one user, about one licence (COLLR-417, ADR-017).
/// The limit of 10 collections per user is enforced by PrismaCollectionRepository.create under a lock on the owner.
model Collection {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  licenceTCGId String      @db.Uuid
  name         String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenceTCG   LicenceTCG  @relation(fields: [licenceTCGId], references: [id], onDelete: Restrict)
  cardEntries  CardEntry[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([licenceTCGId])
  @@map("collections")
}

/// One line of a collection: copies of one card (or printing) in a declared condition and language.
/// Deleted with its collection (ON DELETE CASCADE). `gradingResultId` is reserved for the grading
/// epic: the domain does not model it and updates never touch it.
model CardEntry {
  id              String        @id @default(uuid()) @db.Uuid
  collectionId    String        @db.Uuid
  cardId          String        @db.Uuid
  variantId       String?       @db.Uuid
  gradingResultId String?       @db.Uuid
  quantity        Int
  condition       CardCondition
  language        CardLanguage
  /// 0 to 10 with at most one decimal: decimal(3,1) stores exactly the validated value.
  gradingNote     Decimal?      @db.Decimal(3, 1)
  notes           String?
  collection      Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  card            Card          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  /// Composite key (cardId, variantId) -> variants(cardId, id). With a null variantId the constraint is not checked (MATCH SIMPLE).
  variant         Variant?      @relation(fields: [cardId, variantId], references: [cardId, id], onDelete: Restrict)
  addedAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  /// Serves findCardEntries: newest first, ties broken on the id, without sorting the whole collection.
  @@index([collectionId, addedAt(sort: Desc), id(sort: Desc)])
  @@index([cardId])
  @@map("card_entries")
}
