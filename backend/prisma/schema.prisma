// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Audit trail of sensitive actions (docs/database/schema-sql.md, docs/security/S05-logs-audit.md).
/// Append-only. `userId` has no foreign key yet: the users table does not exist (COLLR-442 adds it).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  /// Convention `domain.verb`, suffixed `.failed` when the action failed (e.g. auth.login.failed).
  action     String
  targetType String?
  targetId   String?  @db.Uuid
  metadata   Json?
  timestamp  DateTime @default(now()) @db.Timestamptz(6)
  /// timestamp + AUDIT_LOG_RETENTION_DAYS, computed when the entry is written.
  expiresAt  DateTime @db.Timestamptz(6)

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([expiresAt])
  @@map("audit_logs")
}

/// Retention period per entity type (GDPR Art. 5.1.e, docs/security/S04-rgpd-conformite.md §5).
/// Reference data: rows are written by the seeder (COLLR-543) and read by the deletion job (COLLR-544).
model DataRetentionPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  /// snake_case identifier of the data category (e.g. account, application_log, audit_log). One policy per type.
  entityType    String   @unique
  /// Counted from the entity's reference event (account closure for accounts, creation for logs).
  retentionDays Int
  description   String
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("data_retention_policies")
}

/// RBAC role (docs/database/schema-sql.md, docs/security/S03-api-security.md §5).
/// Reference data: rows are written by prisma/seed.ts (names in ROLE_NAMES, src/shared/config/AppConstants.ts).
/// No `users` relation yet: COLLR-447 adds users.roleId as a NOT NULL foreign key to this table.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  /// Upper case identifier (USER, ADMIN). Unique so the seed can upsert on it.
  name        String           @unique
  permissions RolePermission[]

  @@map("roles")
}

/// RBAC permission, named `resource:action` (e.g. collection:write, card:delete — docs/database/documentation-metier.md).
/// No permission is seeded yet: the list must be agreed with the team before COLLR-449.
model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

/// Join table between roles and permissions. Deleting a role or a permission deletes its associations.
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Trading card game (docs/database/schema-sql.md: GAME, formerly LICENCE_TCG). Reference data of the catalogue.
/// Part of the catalogue interface contract (ADR-015): the TCG microservice only UPSERTs into it,
/// on `slug`, and never creates or alters the table.
/// The catalogue tables generate their `id` in the database (not with Prisma's uuid(), which runs in the
/// client), so a raw SQL INSERT ... ON CONFLICT does not have to supply one.
model Game {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier of the game (e.g. pokemon). Conflict target of the UPSERT.
  slug      String    @unique
  name      String
  sets      CardSet[]
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("games")
}

/// Set (expansion) of a game, from TCGdex `GET /v2/{lang}/sets/{id}` (en + fr merged in one row).
/// Named CardSet and not Set so the generated client does not shadow the JavaScript `Set`.
/// Catalogue interface contract (ADR-015): UPSERT on `tcgdexId`.
model CardSet {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId                String    @db.Uuid
  /// TCGdex set id, identical in every language (e.g. base1, swsh3, sv03.5).
  tcgdexId              String    @unique
  nameEn                String
  /// null when TCGdex has no French translation of the set.
  nameFr                String?
  /// TCGdex series the set belongs to (e.g. swsh = Sword & Shield / Épée et Bouclier).
  serieTcgdexId         String?
  serieNameEn           String?
  serieNameFr           String?
  releaseDate           DateTime? @db.Date
  /// Code printed on the cards of the set (e.g. DAA).
  abbreviationOfficial  String?
  /// French code, when it differs from the official one (e.g. TEM for DAA). Only the French response has it.
  abbreviationFr        String?
  /// Code of the set in Pokémon TCG Online / Live. null for the most recent sets.
  tcgOnlineCode         String?
  /// Cards printed in the set (TCGdex cardCount.official, e.g. 189 for swsh3).
  officialCardCount     Int
  /// Cards of the set including secret rares (TCGdex cardCount.total, e.g. 201 for swsh3).
  totalCardCount        Int
  /// Printings by variant (TCGdex cardCount.normal / reverse / holo / firstEd): one card can be counted in
  /// several of them, so they do not add up to the total.
  normalCardCount       Int?
  reverseCardCount      Int?
  holoCardCount         Int?
  firstEditionCardCount Int?
  /// Tournament formats the set is legal in.
  legalStandard         Boolean?
  legalExpanded         Boolean?
  /// TCGdex asset base URLs, without extension: nothing is stored locally. Logos depend on the language.
  logoUrlEn             String?
  logoUrlFr             String?
  symbolUrl             String?
  game                  Game      @relation(fields: [gameId], references: [id], onDelete: Restrict)
  cards                 Card[]
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([gameId])
  @@map("sets")
}

/// Card of a set, from TCGdex `GET /v2/{lang}/cards/{id}` (en + fr merged in one row).
/// Catalogue interface contract (ADR-015): UPSERT on `tcgdexId`. Prices are out of scope; the printings of a
/// card are in `variants`. Attacks, abilities, weaknesses, resistances and retreat cost are deliberately not stored.
model Card {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setId           String    @db.Uuid
  /// TCGdex card id, identical in every language (e.g. swsh3-20, sv03.5-006).
  tcgdexId        String    @unique
  /// TCGdex localId: the number inside the set, as printed. A string because of leading zeros (006) and prefixes (TG01).
  number          String
  nameEn          String
  /// null when TCGdex has no French translation of the card.
  nameFr          String?
  /// TCGdex category: Pokemon, Trainer or Energy in English, Pokémon, Dresseur or Énergie in French.
  categoryEn      String
  categoryFr      String?
  rarityEn        String?
  rarityFr        String?
  illustrator     String?
  /// Absent on most Trainer and Energy cards, present on a few (Fossils, Clefairy Doll).
  hp              Int?
  /// Energy types. Empty for most Trainer and Energy cards, but TCGdex does type some (e.g. a Psychic Energy).
  typesEn         String[]  @default([])
  typesFr         String[]  @default([])
  /// National Pokédex numbers of the Pokémon (e.g. [6] for Charizard): links every card of the same Pokémon,
  /// across sets and languages. Several numbers on cards that show several Pokémon.
  dexIds          Int[]     @default([])
  /// Name of the Pokémon this one evolves from (e.g. Charizard V for Charizard VMAX).
  evolveFromEn    String?
  evolveFromFr    String?
  /// Evolution stage: Basic, Stage1, Stage2, VMAX… (Base, Niveau 1, Niveau 2 in French).
  stageEn         String?
  stageFr         String?
  /// Suffix of the card name: V, ex… Same in both languages.
  suffix          String?
  /// Trainer cards only: Item, Supporter, Stadium, Tool (Objet, Supporter, Stade, Outil in French).
  trainerTypeEn   String?
  trainerTypeFr   String?
  /// Energy cards only: Normal or Special (De base or Spécial in French).
  energyTypeEn    String?
  energyTypeFr    String?
  /// Letter printed at the bottom of recent cards (D, G…): it decides when a card leaves the Standard format.
  regulationMark  String?
  /// Tournament formats the card is legal in.
  legalStandard   Boolean?
  legalExpanded   Boolean?
  /// Which kinds of printing exist (TCGdex `variants`). The detail of each printing is in `variants`.
  hasNormal       Boolean   @default(false)
  hasReverse      Boolean   @default(false)
  hasHolo         Boolean   @default(false)
  hasFirstEdition Boolean   @default(false)
  hasWPromo       Boolean   @default(false)
  /// Last modification of the card on the TCGdex side (TCGdex `updated`): lets the sync skip unchanged cards.
  tcgdexUpdatedAt DateTime? @db.Timestamptz(6)
  /// TCGdex asset base URLs, without extension (append /high.webp for instance): nothing is stored locally.
  imageUrlEn      String?
  imageUrlFr      String?
  set             CardSet   @relation(fields: [setId], references: [id], onDelete: Restrict)
  variants        Variant[]
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([setId])
  @@map("cards")
}

/// One printing of a card (normal, reverse holo, 1st edition stamped…), from TCGdex `variants_detailed`.
/// Catalogue interface contract (ADR-015): UPSERT on `(cardId, tcgdexVariantId)`. The TCGdex variantId is NOT
/// unique on its own: it identifies a kind of printing and is shared by many cards (the 16 first cards of base1
/// carry the same four). Collection items and prices will point at `id`.
/// Codes are stored in English only (lower case, kebab-case): TCGdex French labels are partly untranslated.
model Variant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId              String   @db.Uuid
  tcgdexVariantId     String
  /// normal, reverse, holo, metal…
  type                String
  /// unlimited, shadowless, 1999-2000-copyright…
  subtype             String?
  /// standard or jumbo.
  size                String
  /// Stamps printed on the card (1st-edition, pikachu, snowflake…).
  stamps              String[] @default([])
  /// Foil pattern (gold, rainbow, cosmos…).
  foil                String?
  /// Product ids of the printing at the price sources, to match prices later. null when the source has none.
  cardmarketProductId Int?
  tcgplayerProductId  Int?
  cardtraderProductId Int?
  card                Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  /// Prisma only maintains it for its own writes: a raw SQL UPSERT must set it explicitly.
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([cardId, tcgdexVariantId])
  @@map("variants")
}
