// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Audit trail of sensitive actions (docs/database/schema-sql.md, docs/security/S05-logs-audit.md).
/// Append-only. `userId` has no foreign key yet: the users table does not exist (COLLR-442 adds it).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  /// Convention `domain.verb`, suffixed `.failed` when the action failed (e.g. auth.login.failed).
  action     String
  targetType String?
  targetId   String?  @db.Uuid
  metadata   Json?
  timestamp  DateTime @default(now()) @db.Timestamptz(6)
  /// timestamp + AUDIT_LOG_RETENTION_DAYS, computed when the entry is written.
  expiresAt  DateTime @db.Timestamptz(6)

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([expiresAt])
  @@map("audit_logs")
}

/// RBAC role (docs/database/schema-sql.md, docs/security/S03-api-security.md §5).
/// Reference data: rows are written by prisma/seed.ts (names in ROLE_NAMES, src/shared/config/AppConstants.ts).
/// No `users` relation yet: COLLR-447 adds users.roleId as a NOT NULL foreign key to this table.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  /// Upper case identifier (USER, ADMIN, MODERATOR). Unique so the seed can upsert on it.
  name        String           @unique
  permissions RolePermission[]

  @@map("roles")
}

/// RBAC permission, named `resource:action` (e.g. collection:write, card:delete — docs/database/documentation-metier.md).
/// No permission is seeded yet: the list must be agreed with the team before COLLR-449.
model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

/// Join table between roles and permissions. Deleting a role or a permission deletes its associations.
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
