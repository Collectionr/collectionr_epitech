# Environnement d'exécution : development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL (instance fournie par l'environnement — DevOps)
DATABASE_URL=postgresql://collectionr:collectionr@localhost:5432/collectionr?schema=public

# Redis (instance fournie par l'environnement — DevOps)
REDIS_URL=redis://localhost:6379

# Secret JWT — 32 caractères minimum, à générer par environnement (ex: openssl rand -hex 32)
JWT_SECRET=remplacez-moi-par-un-secret-de-32-caracteres-minimum

# Origines autorisées pour le CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Niveau de log : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limiting global : THROTTLE_LIMIT requêtes par fenêtre de THROTTLE_TTL secondes
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Exposition de la documentation Swagger (/api/docs)
SWAGGER_ENABLED=true
