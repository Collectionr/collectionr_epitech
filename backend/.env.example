# Runtime environment: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL (instance provided by the environment — DevOps)
DATABASE_URL=postgresql://collectionr:collectionr@localhost:5432/collectionr

# Maximum size of the PostgreSQL connection pool (1-100, default 5)
DATABASE_POOL_MAX=5

# Redis (instance provided by the environment — DevOps)
REDIS_URL=redis://localhost:6379

# JWT signing secret — generate one per environment: openssl rand -hex 32
# The application REFUSES TO START with this placeholder, with fewer than 32 characters, or with a
# repetitive value (the check is in src/shared/config/JwtSecretPolicy.ts).
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32

# Origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Global rate limiting: THROTTLE_LIMIT requests per window of THROTTLE_TTL seconds
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Retention of audit log entries, in days (>= 1, default 90 — docs/security/S04-rgpd-conformite.md).
# Stored as expiresAt on each entry when it is written.
AUDIT_LOG_RETENTION_DAYS=90

# Minimum password length required at registration/change (8-64, default 8).
# The 72-byte bcrypt truncation limit is a fixed algorithm constraint, not a
# policy — it is NOT configurable here (src/modules/auth/domain/value-objects/Password.ts).
PASSWORD_MIN_LENGTH=8

# Swagger documentation exposure (/api/docs) — disabled when the variable is absent. Enable it
# locally only: it publishes the whole API surface.
# SWAGGER_ENABLED=true

# Access token lifetime, in seconds (default 900 = 15 min, max 3600; docs/security/S03-api-security.md §4.2)
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime, in seconds (default 604800 = 7 days, max 2592000; S03 §4.2).
# Must be longer than the access token lifetime.
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Hard end of a login, in seconds (default 2592000 = 30 days, max 7776000): refreshing renews the
# refresh token but never moves this. Must be at least the refresh token lifetime.
JWT_SESSION_MAX_LIFETIME_SECONDS=2592000

# Reinforced rate limiting on the auth routes, stored in Redis (ADR-008) — on top of (not instead of)
# the global in-memory THROTTLE_* limiter above.
# /auth/login: attempts per account and address per window, then locked for the block duration (S03 §7).
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_BLOCK_SECONDS=900
# /auth/register: attempts per address per window.
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Reverse proxies (ingress, load balancer) whose X-Forwarded-For is believed, comma-separated IP
# addresses or CIDR ranges, e.g. 10.42.0.0/16. Leave empty when the API is reached directly.
# Without it, behind an ingress every client shares the ingress address — and so one rate limit.
TRUSTED_PROXIES=
