# Runtime environment: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL (instance provided by the environment — DevOps)
DATABASE_URL=postgresql://collectionr:collectionr@localhost:5432/collectionr

# Maximum size of the PostgreSQL connection pool (1-100, default 5)
DATABASE_POOL_MAX=5

# Redis (instance provided by the environment — DevOps)
REDIS_URL=redis://localhost:6379

# JWT secret — 32 characters minimum, generate one per environment (e.g. openssl rand -hex 32)
JWT_SECRET=replace-me-with-a-secret-of-at-least-32-characters

# Origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Global rate limiting: THROTTLE_LIMIT requests per window of THROTTLE_TTL seconds
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Swagger documentation exposure (/api/docs) — disabled when the variable is absent
SWAGGER_ENABLED=true
