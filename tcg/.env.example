# Environment: dev | staging
APP_ENV=dev

# Log level: critical | error | warning | info | debug
LOG_LEVEL=info

# Shared PostgreSQL (same database as the NestJS backend — instance provided by DevOps).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Do not copy Prisma-specific parameters (e.g. ?schema=public).
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Maximum size of the connection pool (1-100, default 5)
DATABASE_POOL_MAX=5

# Maximum time to open a connection, in seconds (1-60, default 5)
DATABASE_CONNECT_TIMEOUT=5

# Maximum duration of a business SQL query (workers' UPSERTs), in seconds (1-600, default 30)
DATABASE_STATEMENT_TIMEOUT=30

# Maximum duration of the PostgreSQL health check (/health), in seconds (default 3).
# Only applies to the /health SELECT 1, not to business queries.
HEALTH_CHECK_TIMEOUT=3
