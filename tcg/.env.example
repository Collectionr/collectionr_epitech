# Environnement : dev | staging
APP_ENV=dev

# Niveau de logs : critical | error | warning | info | debug
LOG_LEVEL=info

# PostgreSQL partagé (même base que le backend NestJS — instance fournie par DevOps).
# Schéma postgresql://<utilisateur>:<mot_de_passe>@<hote>:<port>/<base>
# Ne pas reprendre les paramètres propres à Prisma (ex. ?schema=public).
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@<hote>:5432/<base>

# Taille maximale du pool de connexions (1-100, défaut 5)
DATABASE_POOL_MAX=5

# Délai maximal d'établissement d'une connexion, en secondes (1-60, défaut 5)
DATABASE_CONNECT_TIMEOUT=5

# Délai maximal d'une requête SQL métier (UPSERT des workers), en secondes (1-600, défaut 30)
DATABASE_STATEMENT_TIMEOUT=30

# Délai maximal du contrôle de santé PostgreSQL (/health), en secondes (défaut 3).
# Ne s'applique qu'au SELECT 1 de /health, pas aux requêtes métier.
HEALTH_CHECK_TIMEOUT=3
