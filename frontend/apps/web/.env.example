# URL de base de l'API, figée au build (défaut : /api/v1, même domaine derrière l'Ingress).
# Chemin commençant par / ou URL absolue en http(s) ; toute autre valeur bloque le démarrage.
VITE_API_BASE_URL=/api/v1

# Données simulées (MSW), sous npm run dev uniquement : ignorées au build de production.
# Vide (défaut) : aucune simulation, toutes les requêtes vont à l'API.
# all : toute l'API utilisée par le front est simulée (collections), pour travailler sans back.
# Toute autre valeur bloque le démarrage. Voir docs/frontend/docs/data-et-etat.md.
# VITE_API_MOCKS=all

# Cible du proxy de dev Vite pour /api (npm run dev uniquement, jamais exposée au client).
# Défaut : http://localhost:3000
# API_PROXY_TARGET=http://localhost:3000
