# URL absolue de l'API, figée au bundle et visible dans l'application (préfixe EXPO_PUBLIC_).
# Obligatoire, sans défaut : l'application lève une erreur explicite si elle est absente ou relative.
# Une URL relative (/api/v1) ne fonctionne pas sur mobile : il n'y a pas de domaine courant.

# Simulateur iOS : le Mac hôte est joignable via localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Émulateur Android : le Mac hôte est joignable via 10.0.2.2.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
