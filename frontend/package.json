{
  "name": "@collectionr/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo frontend Collectionr (workspaces npm) — voir docs/frontend/docs/architecture.md.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @collectionr/web",
    "dev:mobile": "npm run dev -w @collectionr/mobile",
    "storybook": "npm run storybook -w @collectionr/web",
    "build-storybook": "npm run build-storybook -w @collectionr/web",
    "build": "npm run build --workspaces --if-present",
    "export:mobile": "npm run export -w @collectionr/mobile",
    "typecheck": "tsc -p tsconfig.tooling.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm run test -w @collectionr/mobile",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jiti": "2.7.0",
    "postcss": "8.5.31",
    "prettier": "^3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
