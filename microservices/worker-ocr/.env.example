# Log level, same values as the backend: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Redis OCR (job queue, job statuses and results — instance provided by DevOps).
# Format: redis://[:<password>@]<host>:<port>/<db>   (rediss:// for TLS)
REDIS_URL=redis://<host>:6379/0

# Maximum time to open a connection to Redis, in seconds (default 5)
REDIS_CONNECT_TIMEOUT=5

# Inference engine loaded at startup. Only "stub" (fake engine) for now.
OCR_MODEL=stub

# Fake engine only: simulated inference time per job, in seconds (0-60, default 0)
OCR_STUB_DELAY=0

# Duration of one blocking read of the queue, in seconds (1-60, default 5).
# Also the longest wait before an idle worker notices a shutdown request.
OCR_QUEUE_BLOCK_TIMEOUT=5

# Lifetime of a job status and result in Redis, in seconds (60-86400, default 3600)
OCR_RESULT_TTL=3600

# Maximum number of times a job is started before it is marked as failed (1-10, default 3).
# A job is started again only when the worker stopped while processing it.
OCR_JOB_MAX_ATTEMPTS=3
